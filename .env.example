# Trendyol Seller API (V2) — örnek ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp gerçek değerlerinizi girin.
# ASLA gerçek anahtarları bu dosyaya yazmayın — Git'e push edilir!

# Trendyol "Integration Information" panelinden alınır (40 karakter).
TRENDYOL_API_KEY=your_api_key_here
TRENDYOL_API_SECRET=your_api_secret_here

# Satıcı kimliği (sayısal). Script TRENDYOL_SUPPLIER_ID bekler;
# TRENDYOL_SELLER_ID aynı değerdir (alias).
TRENDYOL_SUPPLIER_ID=your_supplier_id_here
TRENDYOL_SELLER_ID=your_supplier_id_here

# Entegrasyon kodu (UUID) — opsiyonel.
TRENDYOL_INTEGRATION_CODE=your_integration_code_here

# Base64(apiKey:apiSecret) — opsiyonel, script kendisi üretir.
TRENDYOL_TOKEN=your_base64_token_here
