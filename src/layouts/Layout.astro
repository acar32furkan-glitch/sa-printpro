---
import Seo from '../components/Seo.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import CookieBanner from '../components/islands/CookieBanner.jsx'
import { siteConfig } from '../config/site.js'
import '../styles/globals.css'

const {
  title = siteConfig.name,
  description = `${siteConfig.name} — reflektif sticker ve güvenlik etiketi ürünleri.`,
  image = `${siteConfig.domain}/${siteConfig.logoFile}`,
  canonicalUrl = Astro.url.href,
  type = 'website',
  noindex = false,
  // FAZ B — B4: Statik sayfalama için rel="prev"/rel="next" hedefleri.
  prevUrl = null,
  nextUrl = null,
} = Astro.props

const faviconHref = `/${siteConfig.faviconFile}`

// Google Consent Mode v2 — GA4 etiketi STATİK olarak <head>'e basılır ki
// Google'ın doğrulama robotu (çerez kabul etmeyen statik HTML taraması)
// etiketi görebilsin. Veri toplama varsayılan olarak "denied" başlar;
// kullanıcı çerez banner'ından onay verince `consent update granted` çağrılır.
// Placeholder (`G-XXXXXXXXXX`) ise hiç basılmaz.
const ga4Id = siteConfig.ga4Id
const hasGa4Id =
  typeof ga4Id === 'string' && ga4Id.trim() !== '' && ga4Id !== 'G-XXXXXXXXXX'

// SEVİYE 3 — UX: Site geneli sabit (floating) WhatsApp destek butonu.
// Çerez banner'ı sağ altta `bottom-4 right-4` konumunda durduğu için buton
// onun ÜSTÜNE yerleştirilir; böylece iki öğe asla çakışmaz.
const whatsappNumber = String(siteConfig.contact?.whatsapp || '').replace(/\D/g, '')
const whatsappSupportMessage =
  'Merhaba, SA Printpro ürünleri hakkında bilgi almak istiyorum.'
const whatsappSupportUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappSupportMessage
)}`

// 2026 GEO/SEO: Site geneli Organization + LocalBusiness şeması.
// Tüm sayfalarda basılır; marka varlığını AI arama motorlarına tanıtır.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: siteConfig.name,
  url: siteConfig.domain,
  logo: `${siteConfig.domain}/${siteConfig.logoFile}`,
  image: `${siteConfig.domain}/${siteConfig.logoFile}`,
  description: `${siteConfig.name} — reflektif sticker ve güvenlik etiketi ürünleri. Türkiye'de üretim.`,
  ...(siteConfig.contact?.instagram
    ? { sameAs: [`https://www.instagram.com/${siteConfig.contact.instagram}`] }
    : {}),
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${siteConfig.contact.whatsapp}`,
    contactType: 'customer service',
    areaServed: 'TR',
    availableLanguage: ['Turkish'],
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'TR',
  },
}
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f27a1a" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    {
      hasGa4Id && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: 500
});
gtag('js', new Date());
gtag('config', '${ga4Id}');`}
          />
        </>
      )
    }

    <!--
      NOT: Tüm ürün görselleri artık yerel olarak (`/uploads/products/...`)
      sunulduğu için Trendyol CDN'ine preconnect/dns-prefetch gerekmez.
      Bu bağlantılar kaldırıldı; hem gereksiz DNS/TLS el sıkışması önlenir
      hem de harici bir platforma bağımlılık izi kalmaz.
    -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Font CSS'i render-blocking olmaktan çıkar: `media="print"` ile düşük
      öncelikte indirilir, yüklendiğinde `onload` ile `all`'a çevrilir.
      `display=swap` sayesinde metin font yüklenmeden de görünür kalır.
      `<noscript>` fallback'i JS kapalı istemciler için stilleri garanti eder.
    -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      />
    </noscript>

    <Seo
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
      noindex={noindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />

    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme.
      // The site defaults to light mode; dark is only applied when the user
      // has explicitly chosen it (stored preference).
      (function () {
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'dark') {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
        } catch (error) {
          // Storage unavailable (private mode, etc.) — fall back to light.
        }
      })()
    </script>
  </head>

  <body
    class="flex min-h-screen flex-col bg-white font-sans text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white dark:bg-zinc-950 dark:text-zinc-100"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:border focus:border-zinc-900 focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-xs focus:font-semibold focus:text-white dark:focus:border-zinc-50 dark:focus:bg-zinc-50 dark:focus:text-zinc-900"
    >
      İçeriğe geç
    </a>

    <Navbar />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
    />

    <CookieBanner client:load />

    {
      whatsappNumber !== '' && (
        <a
          href={whatsappSupportUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp ile bize yazın"
          title="WhatsApp ile bize yazın"
          class="group fixed bottom-24 right-4 z-40 inline-flex items-center gap-2 rounded-full border border-emerald-700 bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-lift transition-all duration-200 ease-smooth hover:bg-emerald-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 sm:bottom-6 sm:right-6 dark:focus-visible:ring-offset-zinc-950"
        >
          <svg
            class="h-5 w-5 shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          <span class="hidden sm:inline">WhatsApp ile Yaz</span>
        </a>
      )
    }

    <script>
      import { initConsent } from '../lib/consent.js'

      // Re-activates GA4 when a previous visit already granted consent.
      initConsent()
    </script>
  </body>
</html>
