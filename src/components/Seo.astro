---
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'

const {
  title = siteConfig.name,
  description = `${siteConfig.name} — reflektif sticker ve güvenlik etiketi ürünleri.`,
  image = `${siteConfig.domain}/${siteConfig.logoFile}`,
  // Varsayılan canonical: `Astro.url.pathname` üzerinden slash'li üretilir.
  // Böylece canonical, Cloudflare'in 308 ile yönlendirdiği gerçek URL ile
  // birebir eşleşir (slash'siz canonical → "Canonicalised" sorunu önlenir).
  canonicalUrl = buildCanonical(Astro.url.pathname),
  type = 'website',
  noindex = false,
  // FAZ B — B4: Statik sayfalama için rel="prev"/rel="next" hedefleri.
  prevUrl = null,
  nextUrl = null,
} = Astro.props

const fullTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`
const absoluteImage = image.startsWith('http')
  ? image
  : `${siteConfig.domain}${image.startsWith('/') ? '' : '/'}${image}`
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="tr_TR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

{
  /*
    Google doğrulama meta etiketi.
    ÖNEMLİ: Google, aynı sayfada `name="google-site-verification"` ile birden
    fazla etiket görürse YALNIZCA İLKİNİ dikkate alır. Bu yüzden tek bir etiket
    basılır ve öncelik sırası: Search Console → Merchant Center.

    Search Console doğrulaması ayrıca `public/google419bc019c17c40b5.html`
    dosyasıyla da yapılır (HTML dosya yöntemi); meta etiketi yedek/kolaylık
    içindir. Merchant Center doğrulaması ise yalnızca bu meta etiketiyle yapılır.
  */
  (siteConfig.searchConsoleVerification || siteConfig.merchantCenterVerification) && (
    <meta
      name="google-site-verification"
      content={siteConfig.searchConsoleVerification || siteConfig.merchantCenterVerification}
    />
  )
}
