---
/**
 * QA-01: Ürün kartı artık TEK kaynaktan üretilir — `islands/ProductCard.jsx`.
 *
 * Önceden aynı kartın Astro ve React kopyaları vardı; fiyat/stok/CTA mantığı
 * iki ayrı yerde elle senkron tutuluyordu. Biri güncellenmediğinde ana sayfa
 * ile liste sayfaları farklı fiyat veya farklı CTA gösterebiliyordu.
 *
 * Bu sarmalayıcı ürünü kart projeksiyonuna indirger (`toCardProduct`) ve React
 * bileşenine devreder:
 * - SSR çıktısı korunur (Astro island'ları sunucuda render edilir),
 * - hidrasyon `client:visible` ile kart görünür olunca yapılır,
 * - `priority` yalnızca ilk ekran (LCP) kartlarında eager görsel yükler.
 */
import ProductCardReact from './islands/ProductCard.jsx'
import { toCardProduct } from '../lib/products.js'

const { product, priority = false } = Astro.props
const cardProduct = toCardProduct(product)
---

<ProductCardReact product={cardProduct} priority={priority} client:visible />
