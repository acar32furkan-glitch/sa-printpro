---
import { BadgeCheck, ShieldCheck, Sun } from 'lucide-react'
import { siteConfig } from '../config/site.js'

// Trendyol CTA kapalıyken güven rozeti Trendyol'suz metne döner.
const enableTrendyolCta = siteConfig.features?.enableTrendyolCta === true

const badges = [
  {
    icon: BadgeCheck,
    title: '%100 Orijinal SA Printpro Üretimi',
    description: 'Kendi atölyemizde üretilen, aracı olmayan doğrudan ürün.',
  },
  {
    icon: ShieldCheck,
    title: enableTrendyolCta
      ? 'Trendyol Güvencesi & Hızlı Kargo'
      : 'Hızlı Kargo & Güvenli Alışveriş',
    description: enableTrendyolCta
      ? 'Trendyol altyapısıyla güvenli ödeme ve 2 günde kargoda.'
      : 'Shopier ve WhatsApp üzerinden güvenli ödeme, 2 günde kargoda.',
  },
  {
    icon: Sun,
    title: '1. Sınıf Reflektif / Dış Ortam Dayanımı',
    description: 'Su, güneş ve yıkamaya dayanıklı, uzun ömürlü malzeme.',
  },
]
---

<section class="mt-6" aria-label="Ürün güven göstergeleri">
  <ul class="grid gap-3 sm:grid-cols-3">
    {
      badges.map((badge) => {
        const Icon = badge.icon
        return (
          <li class="flex items-start gap-3 rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400">
              <Icon className="h-5 w-5" aria-hidden="true" />
            </span>
            <div class="flex flex-col gap-1">
              <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
                {badge.title}
              </span>
              <span class="text-xs text-zinc-500 dark:text-zinc-400">
                {badge.description}
              </span>
            </div>
          </li>
        )
      })
    }
  </ul>
</section>
