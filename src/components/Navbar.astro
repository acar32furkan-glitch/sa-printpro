---
import Logo from './Logo.astro'
import SearchBar from './islands/SearchBar.jsx'
import ThemeToggle from './islands/ThemeToggle.jsx'
import MobileNav from './islands/MobileNav.jsx'

const links = [
  { label: 'Ürünler', href: '/urunler' },
  { label: 'İletişim', href: '/iletisim' },
]

const currentPath = Astro.url.pathname
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200 bg-white/90 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/90"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:gap-4"
    aria-label="Ana menü"
  >
    <Logo />

    <ul class="ml-2 hidden items-center gap-1 md:flex">
      {
        links.map((link) => {
          const isActive = currentPath === link.href
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200',
                  isActive
                    ? 'text-zinc-900 dark:text-zinc-50'
                    : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50',
                ]}
              >
                {link.label}
                {isActive && (
                  <span
                    class="absolute inset-x-3 -bottom-px h-px bg-zinc-900 dark:bg-zinc-50"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          )
        })
      }
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <div class="hidden w-56 sm:block lg:w-72">
        <SearchBar client:idle />
      </div>
      <ThemeToggle client:load />
      <MobileNav client:load links={links} currentPath={currentPath} />
    </div>
  </nav>
</header>
