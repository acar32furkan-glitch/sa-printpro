---
import Layout from '../layouts/Layout.astro'
import { siteConfig } from '../config/site.js'
---

<Layout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa bulunamadı. Kataloğa dönerek ürünlere göz atabilirsiniz."
  canonicalUrl={`${siteConfig.domain}/404`}
  noindex={true}
>
  <section
    class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center"
  >
    <span class="text-6xl font-bold tracking-tight text-zinc-900 sm:text-7xl dark:text-zinc-50">
      404
    </span>

    <h1 class="mt-4 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      Sayfa Bulunamadı
    </h1>
    <p class="mt-2 max-w-md text-sm text-zinc-500 dark:text-zinc-400">
      Aradığınız sayfa taşınmış veya hiç var olmamış olabilir. Kataloğa dönerek
      tüm ürünlerimize göz atabilirsiniz.
    </p>

    <a href="/urunler" class="btn-primary mt-8">
      Kataloğa Dön
    </a>
  </section>
</Layout>
