---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'

const canonicalUrl = buildCanonical('/iade-ve-cayma-hakki')

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'İade ve Cayma Hakkı' },
]

const whatsappDisplay = `+${siteConfig.contact.whatsapp}`

// Kurumsal bilgiler tek merkezi kaynaktan (src/config/site.js → company) gelir.
const company = siteConfig.company || {}

const steps = [
  {
    title: '1. Adım — Talebinizi İletin',
    body: `Cayma hakkınızı kullanmak için ürünü teslim aldığınız tarihten itibaren 14 (on dört) gün içinde WhatsApp (${whatsappDisplay}) veya ${siteConfig.contact.email} üzerinden bizimle iletişime geçin. Mesajınızda sipariş numaranızı, ürün adını ve iade gerekçenizi (cayma hakkında gerekçe zorunlu değildir) belirtmeniz yeterlidir.`,
  },
  {
    title: '2. Adım — İade Onayı ve Kargo',
    body: `Talebiniz onaylandığında size iade kargo sürecini ve gönderim adresini ileteceğiz. Ürünü, orijinal ambalajı ve varsa tüm aksesuarları ile birlikte, anlaşmalı kargo firmamız aracılığıyla aşağıdaki iade adresine gönderin. Cayma hakkı kapsamındaki iadelerde kargo masrafı SATICI tarafından karşılanır.`,
  },
  {
    title: '3. Adım — Ürün Kontrolü',
    body: `Ürün tarafımıza ulaştığında, ürünün kullanılmamış ve yeniden satılabilir durumda olup olmadığı kontrol edilir. Mesafeli Sözleşmeler Yönetmeliği uyarınca, ürünün olağan kullanımından kaynaklanan değişiklikler dışında bir kullanım tespit edilirse, bedel iadesinde ayıp oranında indirim yapılabilir.`,
  },
  {
    title: '4. Adım — Ücret İadesi',
    body: `Ürünün tarafımıza ulaşmasını ve kontrolün tamamlanmasını takiben en geç 14 (on dört) gün içinde, ödeme yaptığınız yönteme uygun şekilde (Shopier üzerinden yapılan ödemelerde ilgili karta) bedel iadesi gerçekleştirilir. İade tutarı, kargo masrafı dahil olmak üzere ALICI'dan tahsil edilen tüm bedeli kapsar.`,
  },
]

const sections = [
  {
    title: '14 Günlük Cayma Hakkı',
    body: `6502 sayılı Tüketicinin Korunması Hakkında Kanun ve Mesafeli Sözleşmeler Yönetmeliği uyarınca; ALICI, sözleşme konusu ürünü teslim aldığı tarihten itibaren 14 (on dört) gün içinde hiçbir gerekçe göstermeksizin ve cezai şart ödemeksizin cayma hakkına sahiptir. Cayma hakkı süresi, ürünün ALICI'ya veya ALICI'nın belirlediği üçüncü kişiye teslim edildiği gün başlar.`,
  },
  {
    title: 'İade Adresi',
    body: `İade gönderimleri aşağıdaki adrese yapılmalıdır:

${[company.returnAddress, company.returnRecipient ? `Alıcı: ${company.returnRecipient}` : '']
      .filter(Boolean)
      .join('\n')}

Lütfen iade paketinizin içine sipariş numaranızı ve iletişim bilgilerinizi ekleyin.`,
  },
  {
    title: 'Kargo Masrafını Kim Öder?',
    body: `Cayma hakkı kapsamında yapılan iadelerde kargo masrafı SATICI tarafından karşılanır. Ayıplı (hasarlı, eksik veya tanımına uymayan) ürünlerde de kargo masrafı SATICI'ya aittir. Yalnızca ALICI'nın talebiyle yapılan ve cayma hakkı kapsamına girmeyen özel gönderimlerde kargo masrafı ALICI'ya ait olabilir; bu durum iade öncesinde ALICI'ya açıkça bildirilir.`,
  },
  {
    title: 'Cayma Hakkının Kullanılamayacağı Ürünler',
    body: `Mesafeli Sözleşmeler Yönetmeliği m.15 uyarınca aşağıdaki ürünlerde cayma hakkı kullanılamaz:

• ALICI'nın istekleri veya kişisel ihtiyaçları doğrultusunda hazırlanan (kişiye özel ölçü, özel tasarım, özel metin/logo baskılı) ürünler,
• Tesliminden sonra ambalaj, bant, mühür gibi koruyucu unsurları açılmış olan ürünler,
• Niteliği itibarıyla iade edilemeyecek ve çabuk bozulma riski taşıyan ürünler,
• Tek kullanımlık veya hijyen açısından iade edilmesi uygun olmayan ürünler.

Kişiye özel üretim yapılan siparişlerde, üretime başlanmadan önce iptal talebiniz kabul edilir; üretim tamamlandıktan sonra bu ürünler cayma hakkı kapsamı dışındadır.`,
  },
  {
    title: 'İade Talep Formu',
    body: `Aşağıdaki formu kopyalayıp doldurarak WhatsApp (${whatsappDisplay}) veya ${siteConfig.contact.email} adresine iletebilirsiniz:

--- İADE TALEP FORMU ---
Ad Soyad: [DOLDURULACAK: adınız soyadınız]
Sipariş No: [DOLDURULACAK: sipariş numaranız]
Ürün Adı / Varyant: [DOLDURULACAK: ürün ve varyant bilgisi]
Teslim Alma Tarihi: [DOLDURULACAK: teslim tarihi]
İade Gerekçesi: [DOLDURULACAK: cayma hakkı / ayıplı ürün / diğer]
IBAN (ücret iadesi için): [DOLDURULACAK: IBAN]
İletişim (Telefon/E-posta): [DOLDURULACAK: iletişim bilgisi]
Tarih: [DOLDURULACAK: tarih]
-------------------------`,
  },
  {
    title: 'İletişim',
    body: `İade ve cayma hakkına ilişkin sorularınız için ${siteConfig.contact.email} adresinden veya WhatsApp (${whatsappDisplay}) üzerinden bize ulaşabilirsiniz.`,
  },
]
---

<Layout
  title="İade ve Cayma Hakkı"
  description={`${siteConfig.name} 14 günlük cayma hakkı, adım adım iade süreci, kargo masrafı, iade adresi ve iade talep formu. Tüketici haklarınız hakkında bilgi alın.`}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <article class="mx-auto max-w-3xl px-4 pb-16">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      İade ve Cayma Hakkı
    </h1>
    <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
      Son güncelleme: {new Date().getFullYear()}
    </p>

    <section class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        İade Süreci (Adım Adım)
      </h2>
      <ol class="mt-4 flex flex-col gap-4">
        {
          steps.map((step) => (
            <li class="rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">
                {step.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="mt-10 flex flex-col gap-8">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
              {section.title}
            </h2>
            <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {section.body}
            </p>
          </section>
        ))
      }
    </div>
  </article>
</Layout>
