---
import Layout from '../layouts/Layout.astro'
import HowToApply from '../components/HowToApply.astro'
import ProductCard from '../components/ProductCard.astro'
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'
import {
  getAllBrandsWithCounts,
  getAllCategories,
  getSortedProducts,
} from '../lib/products.js'

const FEATURED_LIMIT = 12

const products = getSortedProducts()
const categories = getAllCategories()
const brands = getAllBrandsWithCounts()
const productCount = products.length

// Ana sayfa vitrini: akıllı skora göre sıralanmış en iyi ürünler.
// Tamamı sunucu tarafında (Astro) render edilir; client-side grid yoktur.
const featuredProducts = products.slice(0, FEATURED_LIMIT)
---

<Layout
  title={siteConfig.name}
  description={`${siteConfig.name} — ${productCount} reflektif sticker ve güvenlik etiketi ürünü. Kategorilere göz atın, fiyata göre sıralayın.`}
  canonicalUrl={buildCanonical('/')}
>
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Ürünler
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {productCount} ürün · {categories.length} kategori
      </p>
    </div>

    {
      siteConfig.features?.enableTrendyolCta === true && (
        <a
          href={siteConfig.trendyol.storeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex items-center gap-3 rounded-lg border border-[#F27A1A]/30 bg-[#F27A1A]/5 px-4 py-3 text-sm text-zinc-700 transition-colors hover:border-[#F27A1A] hover:bg-[#F27A1A]/10 dark:text-zinc-200"
        >
          <span
            class="flex h-2 w-2 shrink-0 rounded-full bg-[#F27A1A]"
            aria-hidden="true"
          />
          <span class="text-pretty">
            Trendyol mağazamızı takip ederek kupon fırsatlarından ve yeni reflektif
            tasarımlardan anında haberdar olun.
          </span>
          <span class="ml-auto hidden shrink-0 text-xs font-semibold text-[#F27A1A] sm:inline">
            Mağazaya Git →
          </span>
        </a>
      )
    }

    {
      categories.length > 0 && (
        <nav class="mt-5" aria-label="Kategoriler">
          <ul class="flex flex-wrap items-center gap-2">
            <li>
              <a
                href="/urunler"
                class="inline-flex items-center rounded-full border border-zinc-900 bg-zinc-900 px-3.5 py-1.5 text-xs font-medium text-white transition-colors hover:bg-zinc-700 dark:border-zinc-100 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
              >
                Tümü
              </a>
            </li>
            {categories.map((category) => (
              <li>
                <a
                  href={`/kategori/${category.slug}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600"
                >
                  {category.name}
                  <span class="text-zinc-600 dark:text-zinc-400">
                    {category.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      brands.length > 0 && (
        <nav class="mt-4" aria-label="Motosiklet markaları">
          <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">
            Motosiklet Markanı Seç
          </span>
          <ul class="mt-2 flex flex-wrap items-center gap-2">
            {brands.map((brand) => (
              <li>
                <a
                  href={`/marka/${brand.slug}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600"
                >
                  {brand.name}
                  <span class="text-zinc-600 dark:text-zinc-400">
                    {brand.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8" aria-label="Öne Çıkan Ürünler">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Öne Çıkan Ürünler
      </h2>
      {/* NOT: "En çok tercih edilen" ifadesi gerçek satış/sipariş verisine
          dayanmadığı için (WhatsApp siparişleri sistematik toplanmıyor)
          yanıltıcı sosyal kanıt oluşturuyordu. Nötr bir ifadeye çevrildi. */}
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Seçili {featuredProducts.length} ürün
      </p>
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        featuredProducts.map((product, index) => (
          <li>
            {/* İlk 4 kart (mobilde ilk 2) ilk ekranda görünür → LCP için
                eager + fetchpriority="high"; kalanlar lazy kalır. */}
            <ProductCard product={product} priority={index < 4} />
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex justify-center">
      <a
        href="/urunler"
        class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 dark:focus-visible:ring-zinc-100 dark:focus-visible:ring-offset-zinc-900"
      >
        Tüm Ürünleri Gör ({productCount})
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <HowToApply />
</Layout>
