---
import Layout from '../layouts/Layout.astro'
import CartView from '../components/islands/CartView.jsx'
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'

// Sepet sayfası kişiye özel ve dinamik içerik barındırır; arama motorlarına
// kapalıdır (noindex, follow).
const canonicalUrl = buildCanonical('/sepet')
---

<!--
  SEO: Sepet sayfası `noindex` olduğu için başlık uzunluğu kritik değildir;
  ancak sekme/SERP görünümünde ayırt edici olması için genişletilir.
-->
<Layout
  title="Sepetim — Reflektif Sticker Siparişi"
  description="Sepetinizdeki reflektif sticker ve güvenlik etiketi ürünlerini inceleyin, adetleri güncelleyin ve siparişinizi tamamlayın."
  canonicalUrl={canonicalUrl}
  noindex={true}
>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-6 flex flex-col gap-1">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Sepetim
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Ürünlerinizi kontrol edin ve siparişinizi tamamlayın.
      </p>
    </div>

    <CartView client:load />
  </section>
</Layout>
