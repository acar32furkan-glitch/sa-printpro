---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { siteConfig } from '../config/site.js'

const canonicalUrl = `${siteConfig.domain}/hakkimizda`

const whatsappNumber = String(siteConfig.contact.whatsapp || '').replace(/\D/g, '')

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hakkımızda' },
]

const values = [
  {
    title: 'Yerli Üretim',
    body: 'Tüm ürünlerimiz Türkiye’de, kendi atölyemizde üretilir. Tasarımdan baskıya kadar her aşama SA Printpro kontrolündedir.',
  },
  {
    title: 'Kalite ve Dayanıklılık',
    body: 'Reflektif folyo, jant şeridi ve sticker ürünlerimizde su, basınçlı yıkama ve UV ışınlarına dayanıklı, solmaz malzemeler kullanırız.',
  },
  {
    title: 'Hızlı Kargo',
    body: `${siteConfig.badges.shipping}. ${siteConfig.badges.freeShipping} (${siteConfig.badges.freeShippingThreshold} TL ve üzeri siparişlerde).`,
  },
]

const products = [
  {
    title: 'Reflektif Folyo',
    body: 'Gece görünürlüğünü artıran, petek dokulu yüksek yansımalı reflektif folyo ürünleri.',
  },
  {
    title: 'Jant Şeridi',
    body: 'Motosiklet ve otomobiller için modele özel, kolay uygulanan reflektif jant şeritleri.',
  },
  {
    title: 'Sticker ve Etiket',
    body: 'Araç, motosiklet ve genel kullanım için dayanıklı, kesimli sticker ve güvenlik etiketleri.',
  },
]

const channels = [
  {
    label: 'WhatsApp',
    value: `+${whatsappNumber}`,
    href: `https://wa.me/${whatsappNumber}`,
  },
  {
    label: 'E-posta',
    value: siteConfig.contact.email,
    href: `mailto:${siteConfig.contact.email}`,
  },
  {
    label: 'Instagram',
    value: `@${siteConfig.contact.instagram}`,
    href: `https://instagram.com/${siteConfig.contact.instagram}`,
  },
]
---

<Layout
  title="Hakkımızda"
  description={`${siteConfig.name} marka hikayesi, üretim yaklaşımı ve iletişim bilgileri. Reflektif folyo, jant şeridi ve sticker ürünlerinde yerli üretim.`}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <article class="mx-auto max-w-3xl px-4 pb-16">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      Hakkımızda
    </h1>

    <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {siteConfig.name}, motosiklet ve otomobil tutkunları için reflektif folyo, jant şeridi ve
      sticker ürünleri üreten yerli bir markadır. Yola çıkış amacımız basit: gece görünürlüğünü
      artıran, uzun ömürlü ve uygun fiyatlı ürünleri doğrudan üreticiden sunmak.
    </p>

    <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      Ürünlerimizi kendi atölyemizde tasarlayıp üretiyor, aracı katmanları ortadan kaldırarak
      kaliteli ürünü komisyonsuz fiyatlarla sizlere ulaştırıyoruz. Siparişlerinizi WhatsApp
      üzerinden alıyor, ödemeyi Shopier güvenli ödeme altyapısı üzerinden tamamlıyoruz.
    </p>

    <section class="mt-10">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        Neden Biz?
      </h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          values.map((value) => (
            <li class="rounded-lg border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
              <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
                {value.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {value.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        Ürün Gruplarımız
      </h2>
      <ul class="mt-4 flex flex-col gap-4">
        {
          products.map((product) => (
            <li class="rounded-lg border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
              <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
                {product.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {product.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        Kurumsal Bilgi
      </h2>
      <dl class="mt-4 flex flex-col gap-3 text-sm">
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
          <dt class="font-medium text-zinc-900 dark:text-zinc-100">İşletme Adı:</dt>
          <dd class="text-zinc-600 dark:text-zinc-400">{siteConfig.name}</dd>
        </div>
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
          <dt class="font-medium text-zinc-900 dark:text-zinc-100">Faaliyet Alanı:</dt>
          <dd class="text-zinc-600 dark:text-zinc-400">
            Reflektif folyo, jant şeridi ve sticker üretimi
          </dd>
        </div>
      </dl>
      <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        Detaylı kurumsal bilgi (adres, vergi bilgileri vb.) için lütfen bizimle iletişime geçin.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        İletişim
      </h2>
      <ul class="mt-4 flex flex-col gap-3">
        {
          channels.map((channel) => (
            <li class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
              <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">
                {channel.label}:
              </span>
              <a
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-zinc-600 underline-offset-4 transition-colors hover:text-zinc-900 hover:underline dark:text-zinc-400 dark:hover:text-zinc-100"
              >
                {channel.value}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
