---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'

const canonicalUrl = buildCanonical('/cerez-politikasi')

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Çerez Politikası' },
]

const cookieTypes = [
  {
    name: 'Zorunlu Çerezler',
    purpose:
      'Sitenin temel işlevlerinin çalışması için gereklidir. Tema tercihi (açık/koyu mod) ve çerez onay durumunuzun hatırlanması bu kapsamdadır. Bu çerezler devre dışı bırakılamaz ve kişisel veri işlemez.',
    examples: 'sa-cookie-consent (localStorage), theme (localStorage)',
    consent: 'Onay gerekmez',
  },
  {
    name: 'Analitik Çerezler',
    purpose:
      'Site trafiğini ve kullanım davranışını anonim olarak ölçmek, hizmet kalitesini iyileştirmek için kullanılır. Google Analytics 4 bu kapsamdadır ve IP anonimleştirmesi uygulanır. Yalnızca açık rızanız ile etkinleşir.',
    examples: '_ga, _ga_HK6Q53CMG1 (Google Analytics 4)',
    consent: 'Açık rıza gerekir',
  },
  {
    name: 'Pazarlama Çerezleri',
    purpose:
      'Sitemiz şu anda pazarlama/reklam amaçlı çerez kullanmamaktadır. İleride kullanılması halinde, bu çerezler yalnızca açık rızanız ile etkinleştirilecek ve bu politika güncellenecektir.',
    examples: 'Şu anda kullanılmıyor',
    consent: 'Açık rıza gerekir',
  },
]

const sections = [
  {
    title: '1. Çerez Nedir?',
    body: `Çerezler (cookies), ziyaret ettiğiniz web siteleri tarafından tarayıcınıza kaydedilen küçük metin dosyalarıdır. Çerezler; sitenin düzgün çalışmasını sağlamak, tercihlerinizi hatırlamak ve site kullanımını anonim olarak analiz etmek amacıyla kullanılır. Benzer şekilde, tarayıcınızın yerel depolama alanı (localStorage) da tercihlerinizi saklamak için kullanılabilir.`,
  },
  {
    title: '2. Çerezlerin Kullanım Amaçları',
    body: `Sitemizde çerezler aşağıdaki amaçlarla kullanılır:

• Sitenin temel işlevlerinin (tema tercihi, çerez onay durumu) çalışmasını sağlamak
• Çerez tercihlerinizi hatırlayarak her ziyarette tekrar sormamak
• Açık rızanız bulunması halinde, site trafiğini anonim olarak ölçmek ve iyileştirmek`,
  },
  {
    title: '3. Çerez Tercihlerinizin Yönetimi',
    body: `Siteyi ilk ziyaretinizde görüntülenen çerez bildirimi üzerinden analitik çerezleri "Kabul Et" veya "Reddet" seçenekleriyle yönetebilirsiniz. Tercihiniz tarayıcınızın yerel depolamasında saklanır ve sonraki ziyaretlerinizde hatırlanır.

Tercihinizi dilediğiniz zaman değiştirebilirsiniz:
• Tarayıcınızın ayarlar menüsünden çerezleri ve site verilerini temizleyerek (bu işlem tercihinizi sıfırlar ve bildirim yeniden görüntülenir),
• Tarayıcınızın gizlilik/güvenlik ayarlarından çerezleri engelleyerek veya silerek.

Tarayıcı bazında çerez yönetimi için ilgili tarayıcının yardım sayfalarını inceleyebilirsiniz (Chrome, Firefox, Safari, Edge).`,
  },
  {
    title: '4. Üçüncü Taraf Çerezleri',
    body: `Açık rızanızı vermeniz halinde Google Analytics 4 hizmeti aracılığıyla üçüncü taraf analitik çerezleri kullanılır. Bu çerezler, Google'ın gizlilik politikasına tabidir ve IP anonimleştirmesi uygulanarak kişisel olarak tanımlanabilir bilgi toplanmaz. Ödeme işlemleri Shopier güvenli ödeme sayfasında gerçekleştiğinden, ödeme sayfasına ait çerezler ilgili ödeme kuruluşunun politikalarına tabidir.`,
  },
  {
    title: '5. Çerez Onayı ve Hukuki Dayanak',
    body: `Zorunlu çerezler, sitenin temel işlevleri için gerekli olduğundan KVKK m.5/2 kapsamında onay aranmaksızın kullanılır. Analitik ve pazarlama çerezleri ise yalnızca KVKK m.5/1 kapsamındaki açık rızanıza dayanılarak kullanılır. Rızanızı vermemeniz halinde bu çerezler etkinleştirilmez ve siteyi kullanmaya devam edebilirsiniz.`,
  },
  {
    title: '6. İletişim',
    body: `Çerez politikasına ilişkin sorularınız için ${siteConfig.contact.email} adresinden bize ulaşabilirsiniz. Kişisel verilerinizin işlenmesine ilişkin ayrıntılı bilgi için KVKK Aydınlatma Metni ve Gizlilik Politikası sayfalarını inceleyebilirsiniz.`,
  },
]
---

<Layout
  title="Çerez Politikası"
  description={`${siteConfig.name} çerez politikası: kullanılan çerez türleri (zorunlu, analitik, pazarlama), amaçları, çerez onayı ve tercihlerinizi yönetme yöntemleri.`}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <article class="mx-auto max-w-3xl px-4 pb-16">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      Çerez Politikası
    </h1>
    <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
      Son güncelleme: {new Date().getFullYear()}
    </p>

    <section class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        Kullanılan Çerez Türleri
      </h2>
      <div class="mt-4 flex flex-col gap-4">
        {
          cookieTypes.map((type) => (
            <div class="rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">
                  {type.name}
                </h3>
                <span class="inline-flex items-center rounded-md border border-zinc-200 bg-zinc-50 px-2 py-0.5 text-2xs font-medium text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {type.consent}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {type.purpose}
              </p>
              <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-500">
                Örnekler: {type.examples}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="mt-10 flex flex-col gap-8">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
              {section.title}
            </h2>
            <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {section.body}
            </p>
          </section>
        ))
      }
    </div>
  </article>
</Layout>
