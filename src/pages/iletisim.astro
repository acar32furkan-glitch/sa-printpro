---
import Layout from '../layouts/Layout.astro'
import { siteConfig } from '../config/site.js'
import { buildCanonical } from '../lib/seo.js'

const whatsappNumber = String(siteConfig.contact.whatsapp || '').replace(/\D/g, '')

const channels = [
  {
    label: 'WhatsApp',
    description: 'Hızlı sipariş ve ürün soruları için yazın.',
    href: `https://wa.me/${whatsappNumber}`,
    cta: 'WhatsApp ile Yaz',
  },
  {
    label: 'Instagram',
    description: 'Yeni ürünler ve kampanyalar için bizi takip edin.',
    href: `https://instagram.com/${siteConfig.contact.instagram}`,
    cta: 'Instagram Profili',
  },
  {
    label: 'E-posta',
    description: 'Toptan ve kurumsal talepler için e-posta gönderin.',
    href: `mailto:${siteConfig.contact.email}`,
    cta: 'E-posta Gönder',
  },
]

// Kurumsal/şeffaflık bilgileri tek merkezi kaynaktan (src/config/site.js →
// company) gelir; boş alanlar aşağıdaki filter ile otomatik gizlenir.
const company = siteConfig.company || {}
const companyInfo = [
  { label: 'Ticari Unvan', value: company.legalName },
  { label: 'Açık Adres', value: company.address },
  {
    label: 'Telefon',
    value: company.phone,
    href: `tel:${String(company.phone || '').replace(/\s/g, '')}`,
  },
  { label: 'E-posta', value: company.email, href: `mailto:${company.email}` },
  { label: 'Vergi Dairesi / VKN', value: company.taxOffice },
].filter((entry) => Boolean(entry.value))
---

<!--
  SEO: "İletişim" tek başına (22 karakter) çok kısaydı. Başlık, iletişim
  kanallarını belirten bir ifadeyle genişletilir; `Seo.astro` marka adını
  sonek olarak ekler.
-->
<Layout
  title="İletişim — WhatsApp, Instagram ve E-posta"
  description={`${siteConfig.name} ile iletişime geçin: WhatsApp, Instagram ve e-posta kanalları.`}
  canonicalUrl={buildCanonical('/iletisim')}
>
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      İletişim
    </h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      Sipariş ve ürün sorularınız için bize ulaşın.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        channels.map((channel) => (
          <li class="flex flex-col gap-4 rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex flex-col gap-1">
              <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
                {channel.label}
              </h2>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">
                {channel.description}
              </p>
            </div>

            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary mt-auto w-full"
            >
              {channel.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12">
    <div class="rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
        Kurumsal Bilgiler
      </h2>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
        Satıcı/şirket bilgileri ve yasal iletişim detayları.
      </p>

      <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
        {
          companyInfo.map((entry) => (
            <div class="flex flex-col gap-0.5 border-b border-zinc-100 pb-2 sm:flex-row sm:gap-2 dark:border-zinc-800">
              <dt class="shrink-0 font-medium text-zinc-500 dark:text-zinc-400">
                {entry.label}:
              </dt>
              <dd class="text-zinc-700 dark:text-zinc-200">
                {entry.href ? (
                  <a
                    href={entry.href}
                    class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-50"
                  >
                    {entry.value}
                  </a>
                ) : (
                  entry.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>
