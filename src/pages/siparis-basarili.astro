---
import Layout from '../layouts/Layout.astro'
import { siteConfig } from '../config/site.js'

// Ödeme dönüş sayfası: kişiye özel ve dinamik içerik barındırır,
// arama motorlarına kapalıdır (noindex, follow).
const canonicalUrl = `${siteConfig.domain}/siparis-basarili`

const whatsappNumber = String(siteConfig.contact.whatsapp || '').replace(/\D/g, '')
const whatsappUrl = `https://wa.me/${whatsappNumber}`
---

<Layout
  title="Siparişiniz Alındı"
  description="Siparişiniz başarıyla alındı. Sipariş detaylarınız ve sonraki adımlar hakkında bilgi."
  canonicalUrl={canonicalUrl}
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex flex-col items-center gap-4 rounded-lg border border-emerald-200 bg-emerald-50 px-6 py-10 text-center dark:border-emerald-900 dark:bg-emerald-950">
      <span
        class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-2xl font-bold text-white"
        aria-hidden="true"
      >
        ✓
      </span>
      <h1 class="text-2xl font-bold tracking-tight text-emerald-900 dark:text-emerald-100">
        Siparişiniz Alındı
      </h1>
      <p class="max-w-xl text-sm text-emerald-800 dark:text-emerald-200">
        Ödemeniz başarıyla tamamlandı. Siparişiniz hazırlanmaya alınacaktır.
      </p>

      <p
        id="order-number"
        class="hidden rounded-lg border border-emerald-300 bg-white px-4 py-2 text-sm font-semibold text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900 dark:text-emerald-100"
      >
        Sipariş No: <span id="order-number-value"></span>
      </p>
    </div>

    <div class="mt-8 rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
        Bundan Sonra Ne Olacak?
      </h2>
      <ol class="mt-4 flex flex-col gap-3 text-sm text-zinc-600 dark:text-zinc-400">
        <li class="flex gap-3">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">1.</span>
          <span>Sipariş onayınız e-posta ve/veya WhatsApp üzerinden tarafınıza iletilir.</span>
        </li>
        <li class="flex gap-3">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">2.</span>
          <span>Ürünleriniz özenle hazırlanır ve 2 iş günü içinde kargoya verilir.</span>
        </li>
        <li class="flex gap-3">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">3.</span>
          <span>Kargo takip bilgisi, gönderim sonrası sizinle paylaşılır.</span>
        </li>
      </ol>

      <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400">
        Sorularınız için WhatsApp üzerinden bize ulaşabilirsiniz.
      </p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-300"
        >
          Ana Sayfaya Dön
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800"
        >
          WhatsApp ile İletişim
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Sipariş numarası query string'de varsa göster (ör. ?order=12345).
    (function () {
      try {
        var params = new URLSearchParams(window.location.search)
        var order =
          params.get('order') || params.get('orderId') || params.get('siparis')
        if (order) {
          var wrapper = document.getElementById('order-number')
          var value = document.getElementById('order-number-value')
          if (wrapper && value) {
            value.textContent = order
            wrapper.classList.remove('hidden')
          }
        }
      } catch (error) {
        // Query okunamazsa sessizce geç.
      }
    })()
  </script>
</Layout>
