---
import Layout from '../../layouts/Layout.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import ProductCard from '../../components/ProductCard.astro'
import { siteConfig } from '../../config/site.js'
import { getAllCategories, getProductsByCategory } from '../../lib/products.js'

export function getStaticPaths() {
  return getAllCategories().map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      products: getProductsByCategory(category.slug),
    },
  }))
}

const { category, products } = Astro.props

const canonicalUrl = `${siteConfig.domain}/kategori/${category.slug}`

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: category.name },
]

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.name,
      item: canonicalUrl,
    },
  ],
}
---

<Layout
  title={category.name}
  description={`${category.name} kategorisinde ${products.length} ürün. ${siteConfig.name} kataloğunda fiyatları karşılaştırın.`}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-12">
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        {category.name}
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {products.length} ürün
      </p>
    </header>

    {
      products.length === 0 ? (
        <p class="mt-8 rounded-lg border border-dashed border-zinc-300 px-6 py-16 text-center text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
          Bu kategoride henüz ürün bulunmuyor.
        </p>
      ) : (
        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {products.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
</Layout>
