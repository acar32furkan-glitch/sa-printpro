---
import Layout from '../../layouts/Layout.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import ProductGrid from '../../components/islands/ProductGrid.jsx'
import { siteConfig } from '../../config/site.js'
import {
  getAllBrandsWithCounts,
  getBrandBySlug,
  getProductsByBrand,
  getSortedProducts,
} from '../../lib/products.js'

export function getStaticPaths() {
  // Yalnızca 0'dan fazla ürünü olan markalar için statik sayfa üret.
  return getAllBrandsWithCounts().map((brand) => ({
    params: { slug: brand.slug },
    props: {
      brand,
      products: getSortedProducts(getProductsByBrand(brand.slug)),
    },
  }))
}

const { brand, products } = Astro.props

const brandConfig = getBrandBySlug(brand.slug)
const brandName = brandConfig?.name || brand.name

const canonicalUrl = `${siteConfig.domain}/marka/${brand.slug}`

const seoTitle = `${brandName} Uyumlu Motosiklet Sticker ve Şeritleri | SA Printpro`
const seoDescription = `${brandName} modelleriyle tam uyumlu reflektif jant şeritleri, depo kaplama ve güvenlik etiketleri. En uygun fiyat ve doğrudan sipariş indirimiyle keşfedin.`

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: brandName },
]

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: brandName,
      item: canonicalUrl,
    },
  ],
}
---

<Layout title={seoTitle} description={seoDescription} canonicalUrl={canonicalUrl}>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-12">
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        {brandName} Uyumlu Reflektif Sticker & Jant Şeridi Modelleri
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {products.length} ürün
      </p>
    </header>

    <p class="mt-3 max-w-3xl text-sm text-zinc-600 dark:text-zinc-400">
      {brandName} motosiklet modelleriniz için özel olarak hazırlanan reflektif
      jant şeritleri, depo kaplama ve güvenlik etiketleri. Tüm ürünler yüksek
      yansımalı döküm folyo ile Türkiye'de üretilir.
    </p>

    <div class="mt-8">
      <ProductGrid client:idle products={products} />
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
</Layout>
