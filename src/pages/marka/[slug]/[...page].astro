---
import Layout from '../../../layouts/Layout.astro'
import Breadcrumb from '../../../components/Breadcrumb.astro'
import Pagination from '../../../components/Pagination.astro'
import ProductGridStatic from '../../../components/islands/ProductGridStatic.jsx'
import { siteConfig } from '../../../config/site.js'
import {
  getAllBrandsWithCounts,
  getBrandBySlug,
  getProductsByBrand,
  getSortedProducts,
} from '../../../lib/products.js'
import { PAGE_SIZE, getTotalPages, pageUrl, paginate } from '../../../lib/pagination.js'

/**
 * FAZ B — B4: `/marka/{slug}` için path-based statik sayfalama.
 *
 * Sayfa 1 → `/marka/{slug}`, sayfa 2 → `/marka/{slug}/2`, ...
 * Yalnızca 0'dan fazla ürünü olan markalar için sayfa üretilir.
 */
export function getStaticPaths() {
  const paths = []

  for (const brand of getAllBrandsWithCounts()) {
    const products = getSortedProducts(getProductsByBrand(brand.slug))
    const totalPages = getTotalPages(products.length, PAGE_SIZE)

    for (let page = 1; page <= totalPages; page += 1) {
      paths.push({
        params: {
          slug: brand.slug,
          // Sayfa 1 parametresiz URL, diğerleri `/marka/{slug}/N`.
          page: page === 1 ? undefined : String(page),
        },
        props: {
          brand,
          page,
          totalPages,
          products: paginate(products, page, PAGE_SIZE),
        },
      })
    }
  }

  return paths
}

const { brand, page, totalPages, products } = Astro.props

const brandConfig = getBrandBySlug(brand.slug)
const brandName = brandConfig?.name || brand.name

const basePath = `/marka/${brand.slug}`
const canonicalUrl = `${siteConfig.domain}${pageUrl(basePath, page)}`

const prevUrl =
  page > 1 ? `${siteConfig.domain}${pageUrl(basePath, page - 1)}` : null
const nextUrl =
  page < totalPages ? `${siteConfig.domain}${pageUrl(basePath, page + 1)}` : null

// `Seo.astro` başlığa otomatik olarak "| SA Printpro" ekler; bu yüzden burada
// marka adı tekrar edilmez (aksi halde çift sonek oluşur).
const pageSuffix = page > 1 ? ` — Sayfa ${page}` : ''
const seoTitle = `${brandName} Uyumlu Motosiklet Sticker ve Şeritleri${pageSuffix}`
// Meta açıklama 160 karakter sınırını aşmamalı (Google kesme riski).
// Sayfa numarası eklenir; böylece sayfalanan URL'lerin açıklamaları farklı olur.
const seoDescription = (
  page > 1
    ? `${brandName} uyumlu reflektif jant şeritleri, depo kaplama ve güvenlik etiketleri — Sayfa ${page}/${totalPages}. En uygun fiyat ve doğrudan sipariş indirimiyle keşfedin.`
    : `${brandName} uyumlu reflektif jant şeritleri, depo kaplama ve güvenlik etiketleri. En uygun fiyat ve doğrudan sipariş indirimiyle keşfedin.`
).slice(0, 160)

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: brandName, href: page > 1 ? basePath : undefined },
  ...(page > 1 ? [{ label: `Sayfa ${page}` }] : []),
]

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: brandName,
      item: `${siteConfig.domain}${basePath}`,
    },
    ...(page > 1
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: `Sayfa ${page}`,
            item: canonicalUrl,
          },
        ]
      : []),
  ],
}
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-12">
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        {brandName} Uyumlu Reflektif Sticker & Jant Şeridi Modelleri
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {brand.count} ürün
        {totalPages > 1 && ` · Sayfa ${page}/${totalPages}`}
      </p>
    </header>

    <p class="mt-3 max-w-3xl text-sm text-zinc-600 dark:text-zinc-400">
      {brandName} motosiklet modelleriniz için özel olarak hazırlanan reflektif
      jant şeritleri, depo kaplama ve güvenlik etiketleri. Tüm ürünler yüksek
      yansımalı döküm folyo ile Türkiye'de üretilir.
    </p>

    <div class="mt-8">
      <ProductGridStatic client:idle products={products} />
    </div>

    <Pagination
      basePath={basePath}
      currentPage={page}
      totalPages={totalPages}
      ariaLabel={`${brandName} ürün sayfaları`}
    />
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
</Layout>
