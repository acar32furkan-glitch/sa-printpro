---
import { existsSync } from 'node:fs'
import Layout from '../../layouts/Layout.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import ProductCard from '../../components/ProductCard.astro'
import ProductTrustBadges from '../../components/ProductTrustBadges.astro'
import HowToApply from '../../components/HowToApply.astro'
import Gallery from '../../components/islands/Gallery.jsx'
import VariantSelector from '../../components/islands/VariantSelector.jsx'
import ProductShare from '../../components/islands/ProductShare.jsx'
import { siteConfig } from '../../config/site.js'
import { buildCanonical, truncateTitleUnique } from '../../lib/seo.js'
import {
  getAllProducts,
  getProductsByCategory,
  resolveCategory,
  resolveProductBrand,
  normalizeProductTitle,
  sanitizeCatalogText,
  detectCompatibleModels,
  getProductPrimaryImage,
  getProductImages,
} from '../../lib/products.js'
import aiEnrichedData from '../../data/ai-enriched.json'

export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props

// FAZ 11: `getProductPrimaryImage` yerel dosya kontrolü için `node:fs`'e
// ihtiyaç duyar. Bu bağımlılığı tarayıcı paketinden uzak tutmak için yalnızca
// SSG (Node) bağlamında global bir köprü üzerinden enjekte ederiz.
globalThis.__SA_PRINTPRO_FS__ = { existsSync }

// FAZ 11: DeepSeek ile üretilmiş zenginleştirilmiş içerik (varsa).
const aiData = aiEnrichedData?.[product.id] || null

// FAZ 11: yerel (logo filigranlı) görsel varsa onu, yoksa CDN görselini kullan.
const primaryImage = getProductPrimaryImage(product)

// FAZ 11: galeri için TÜM görseller — yerel dosya varsa `/uploads/products/{id}-{i}.webp`,
// yoksa ilgili CDN URL'i. Sıra korunur (index 0 ana kare).
const galleryImages = getProductImages(product)

const variants = Array.isArray(product.variants) ? product.variants : []

// Marka alanı: "Oracal" gibi hammadde/malzeme markaları ürünün üretici markası
// DEĞİLDİR. Bu durumda ürün markası SA Printpro olarak gösterilir ve malzeme
// markası ayrı bir satırda ("MALZEME MARKASI") belirtilir; böylece
// "%100 Orijinal SA Printpro Üretimi" mesajıyla çelişki ortadan kalkar.
// Satıcı/mağaza adları (ör. "CEBECİOTO") da ürün markası sayılmaz.
// `islandProduct` bu çözümlenmiş değeri kullandığı için tanım burada yapılır.
const brandInfo = resolveProductBrand(product)

// İstemci adasına (VariantSelector) gönderilen ürün nesnesi. `product.images`
// ham Trendyol CDN URL'lerini içerdiği için, bu nesne HTML'e serileştirildiğinde
// CDN adresleri sayfa kaynağına sızıyordu. Ada yalnızca yerelleştirilmiş
// görselleri görecek şekilde sadeleştirilir; böylece sayfa kaynağında hiçbir
// harici görsel URL'i kalmaz.
//
// `brand` alanı da ham haliyle serileştirildiğinde satıcı/mağaza adları
// (ör. "CEBECİOTO") sayfa kaynağına sızıyordu. Ada, çözümlenmiş marka adını
// (satıcı adları ve jenerik değerler SA Printpro'ya düşer) görecek şekilde
// sadeleştirilir.
const islandProduct = {
  ...product,
  brand: brandInfo.name,
  images: galleryImages.filter(
    (url) => typeof url === 'string' && url.startsWith('/uploads/')
  ),
}

const pricedVariants = variants.filter((variant) =>
  Number.isFinite(Number(variant.salePrice ?? variant.price))
)

const lowestPrice = pricedVariants.reduce((min, variant) => {
  const value = Number(variant.salePrice ?? variant.price)
  if (min === null || value < min) {
    return value
  }
  return min
}, null)

const highestPrice = pricedVariants.reduce((max, variant) => {
  const value = Number(variant.salePrice ?? variant.price)
  if (max === null || value > max) {
    return value
  }
  return max
}, null)

const totalStock = variants.reduce(
  (sum, variant) => sum + (Number(variant.stock) || 0),
  0
)
const inStock = totalStock > 0

// FAZ B — B3: Ham kategoriyi birleşik görünen kategoriye çevir; breadcrumb,
// kategori linkleri ve ilgili ürünler yeni birleşik kategoriyle tutarlı olsun.
// FAZ 4 — G3.1: `categoryOverride` (script ile atanan alt kategori) en yüksek
// önceliğe sahiptir; aksi halde ürün sayfası eski kategoriye link verir.
const category =
  resolveCategory(product.category, product.categoryOverride) || product.category

const canonicalUrl = buildCanonical(`/urun/${product.slug}`)
const categoryUrl = buildCanonical(`/kategori/${category.slug}`)

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: category.name, href: `/kategori/${category.slug}/` },
  { label: product.name },
]

const relatedProducts = getProductsByCategory(category.slug)
  .filter((item) => item.slug !== product.slug)
  .slice(0, 4)

// Programatik SEO: ürünün uyumlu olduğu motosiklet modelleri.
// Hiçbir model tespit edilemezse ürün "üniversal" kabul edilir.
const compatibleModels = detectCompatibleModels(product)
const isUniversal = compatibleModels.length === 0

/**
 * Decodes the common HTML entities that Trendyol descriptions contain so the
 * meta description and JSON-LD never leak raw `&nbsp;` / `&` sequences.
 * @param {string} value
 * @returns {string}
 */
function decodeHtmlEntities(value) {
  const named = {
    ['&nbsp;']: ' ',
    ['&amp;']: '&',
    ['&quot;']: '"',
    ['&#39;']: '\'',
    ['&apos;']: '\'',
    ['&lt;']: '<',
    ['&gt;']: '>',
    ['&hellip;']: '\u2026',
    ['&mdash;']: '\u2014',
    ['&ndash;']: '\u2013',
    ['&rsquo;']: '\u2019',
    ['&lsquo;']: '\u2018',
    ['&rdquo;']: '\u201D',
    ['&ldquo;']: '\u201C',
    ['&deg;']: '\u00B0',
    ['&times;']: '\u00D7',
    ['&euro;']: '\u20AC',
    ['&trade;']: '\u2122',
    ['&reg;']: '\u00AE',
    ['&copy;']: '\u00A9',
  }
  const decodeOnce = (input) =>
    String(input || '')
      .replace(/&#x([0-9a-f]+);/gi, (_, hex) =>
        String.fromCodePoint(parseInt(hex, 16))
      )
      .replace(/&#(\d+);/g, (_, dec) => String.fromCodePoint(Number(dec)))
      .replace(/&[a-z]+;/gi, (entity) => named[entity.toLowerCase()] ?? ' ')

  // Kaynak veri bazen çift kodlanmış olabiliyor (ör. &quot;); sabitlenene
  // kadar çözerek meta etiketlerde ham entity kalmasını engelle.
  let decoded = String(value || '')
  for (let i = 0; i < 3; i += 1) {
    const next = decodeOnce(decoded)
    if (next === decoded) {
      break
    }
    decoded = next
  }
  return decoded
}

// Rakip satıcı izlerini ve bozuk karakterleri meta verisinden arındır.
const plainDescription = sanitizeCatalogText(
  decodeHtmlEntities(String(product.descriptionHtml || '').replace(/<[^>]*>/g, ' '))
)
  .replace(/\s+/g, ' ')
  .trim()

// FAZ 11: AI hook'u meta açıklamanın başına eklenir (varsa).
const aiHook = typeof aiData?.hook === 'string' ? aiData.hook.trim() : ''

/**
 * Meta açıklamayı 160 karaktere indirger. Astro, `"` gibi karakterleri
 * `"` olarak kaçırdığı için ham uzunluk şişebilir; bu yüzden kaçış
 * sonrası uzunluğu güvenli sınırda tutmak adına tırnak/özel karakterleri
 * sadeleştirip kırpıyoruz.
 * @param {string} value
 * @returns {string}
 */
function clampMetaDescription(value) {
  const cleaned = String(value || '')
    .replace(/["'`]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
  if (cleaned.length <= 160) {
    return cleaned
  }
  // Kelime ortasında kesmemek için son boşluktan kırp.
  const truncated = cleaned.slice(0, 160)
  const lastSpace = truncated.lastIndexOf(' ')
  return (lastSpace > 120 ? truncated.slice(0, lastSpace) : truncated).trim()
}

const metaDescription = clampMetaDescription(
  aiHook ||
    (plainDescription.length > 0
      ? plainDescription
      : `${product.name} - En uygun fiyat, dayanıklı malzeme ve hızlı kargo avantajıyla SA Printpro'da.`)
)

// FAZ 11: AI zenginleştirmesi varsa sadeleştirilmiş başlık önceliklendirilir.
// Tümü büyük harfle yazılmış başlıklar okunabilir başlık düzenine çevrilir.
const displayTitle = normalizeProductTitle(
  aiData?.cleanTitle || sanitizeCatalogText(product.name)
)

/**
 * Bir ürünün nihai görünen başlığını (AI cleanTitle varsa onu) döndürür.
 * Tekrar tespiti, ham `name` yerine bu değer üzerinden yapılmalıdır; aksi
 * halde AI başlıkları aynı olan ürünler gözden kaçar.
 * @param {object} item
 * @returns {string}
 */
function effectiveTitle(item) {
  const enriched = aiEnrichedData?.[item.id]
  return String(enriched?.cleanTitle || sanitizeCatalogText(item.name || '')).trim()
}

// Aynı görünen başlığa sahip ürünler (ör. renk varyantları ayrı kayıtlar) aynı
// <title>'ı üretip SEO'da tekrar cezasına yol açıyordu. Çakışma varsa ürün
// kodunu başlığa ekleyerek her sayfayı benzersiz kılıyoruz.
const normalizedTitle = displayTitle.trim().toLocaleLowerCase('tr-TR')
const hasDuplicateTitle = getAllProducts().some(
  (item) =>
    item.slug !== product.slug &&
    effectiveTitle(item).toLocaleLowerCase('tr-TR') === normalizedTitle
)

// SEO başlık formatı: "<Ürün Adı> Modelleri ve Fiyatı" — `Seo.astro` sonuna
// otomatik olarak "| SA Printpro" ekler, bu yüzden burada tekrarlanmaz.
//
// SERP SINIRI: Google başlıkları ~580 pikselde (≈60 karakter) keser. Ürün
// adları uzun olduğunda (ör. 108 karakter) başlığın sonundaki ayırt edici
// bilgi ("Modelleri ve Fiyatı") ve marka soneki kesiliyordu. Bu yüzden ürün
// adı, sonekler de hesaba katılarak kelime ortasında kesilmeden kısaltılır.
//
// BENZERSİZLİK: Kırpma sonrası aynı öneki paylaşan ürünler (ör. renk
// varyantları) aynı başlığı üretebiliyordu. `truncateTitleUnique`, kırpma
// yapıldığında ürün kodunu başlığa ekleyerek her sayfayı benzersiz kılar.
const TITLE_SUFFIXES = [' Modelleri ve Fiyatı', ` | ${siteConfig.name}`]
const metaTitle = truncateTitleUnique(
  `${displayTitle} Modelleri ve Fiyatı`,
  product.id,
  TITLE_SUFFIXES
)

// Technical spec sheet rows derived from the first variant + site config.
const firstVariant = variants[0] || {}

// Trendyol `attributes` (varyant seviyesinde) → spec satırları.
// Varyantta attribute yoksa ürün seviyesindeki ilk varyantın attribute'ları kullanılır.
const attributeRows = Object.entries(firstVariant.attributes || {}).map(([key, value]) => ({
  key: String(key).toLocaleUpperCase('tr-TR'),
  value: String(value),
}))

// Tekilleştirilmiş özellik tablosu: daha önce "Ürün Özellikleri" ve
// "Teknik Özellikler ve Üretim Bilgileri" bölümleri aynı `attributeRows`
// satırlarını iki kez render ediyordu. Artık tek bir tablo üretiliyor;
// aynı anahtar (key) yalnızca bir kez görünür.
// NOT: `brandInfo` yukarıda (islandProduct'tan önce) tanımlanır.
const specRows = [
  { key: 'ÜRÜN KODU', value: firstVariant.sku || String(product.id) },
  { key: 'BARKOD', value: firstVariant.barcode || '—' },
  { key: 'KATEGORİ', value: category.name },
  { key: 'MARKA', value: brandInfo.name },
  ...(brandInfo.materialBrand
    ? [{ key: 'MALZEME MARKASI', value: brandInfo.materialBrand }]
    : []),
  { key: 'KARGO', value: siteConfig.badges.shipping },
]

// FAZ 11: AI tarafından üretilen SSS'ler (varsa) statik SSS'lerin önüne eklenir.
const aiFaqs = Array.isArray(aiData?.faqs)
  ? aiData.faqs
      .filter((faq) => faq && faq.question && faq.answer)
      .map((faq) => ({
        question: String(faq.question),
        answer: String(faq.answer),
      }))
  : []

const staticFaqs = [
  {
    question: 'Bu ürün reflektif mi?',
    answer: `${displayTitle}, gece ve düşük ışık koşullarında yüksek görünürlük sağlayan reflektif bir üründür.`,
  },
  {
    question: 'Kargo süresi ne kadar?',
    answer: `${siteConfig.badges.shipping}. ${siteConfig.badges.freeShipping} (${siteConfig.badges.freeShippingThreshold} TL ve üzeri siparişlerde).`,
  },
  {
    question: 'Nasıl uygulanır?',
    answer:
      'Yüzeyi toz ve yağdan arındırın, koruyucu folyoyu çıkarıp etiketi hizalayarak yerleştirin ve merkezden kenarlara doğru bastırın. Tam yapışma için 24 saat yıkamayın.',
  },
]

// AI SSS'leri önce gelir; aynı soru metni tekrar etmesin.
const seenQuestions = new Set(aiFaqs.map((faq) => faq.question.toLocaleLowerCase('tr-TR')))
const faqs = [
  ...aiFaqs,
  ...staticFaqs.filter(
    (faq) => !seenQuestions.has(faq.question.toLocaleLowerCase('tr-TR'))
  ),
]

// FAZ 11: AI detaylı teknik özellikleri → spec satırları.
const detailedSpecs = aiData?.detailedSpecs || {}
const aiSpecRows = [
  { key: 'Malzeme', value: detailedSpecs.material },
  { key: 'Dayanıklılık', value: detailedSpecs.durability },
  { key: 'Gece Görünürlüğü', value: detailedSpecs.nightVisibility },
  { key: 'Sökülebilirlik', value: detailedSpecs.removal },
].filter((row) => row.value)

// FAZ 11: AI uygulama rehberi (varsa).
const aiApplicationGuide =
  typeof aiData?.applicationGuide === 'string' ? aiData.applicationGuide.trim() : ''

// FAZ 11: AI uyumlu modeller (varsa) — rozetlerde kullanılır.
const aiCompatibleModels = Array.isArray(aiData?.compatibleModels)
  ? aiData.compatibleModels.filter(Boolean).map((model) => String(model))
  : []

// 2026 Google Merchant Center uyumlu iade politikası ve kargo detayları.
const merchantReturnPolicy = {
  '@type': 'MerchantReturnPolicy',
  applicableCountry: 'TR',
  returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
  merchantReturnDays: 15,
  returnMethod: 'https://schema.org/ReturnByMail',
  returnFees: 'https://schema.org/FreeReturn',
}

const shippingDetails = {
  '@type': 'OfferShippingDetails',
  shippingRate: {
    '@type': 'MonetaryAmount',
    value: 0,
    currency: 'TRY',
  },
  shippingDestination: {
    '@type': 'DefinedRegion',
    addressCountry: 'TR',
  },
  deliveryTime: {
    '@type': 'ShippingDeliveryTime',
    handlingTime: {
      '@type': 'QuantitativeValue',
      minValue: 0,
      maxValue: 1,
      unitCode: 'DAY',
    },
    transitTime: {
      '@type': 'QuantitativeValue',
      minValue: 1,
      maxValue: 3,
      unitCode: 'DAY',
    },
  },
}

// Google Görsel SEO: `image` alanı zengin `ImageObject` formatında sunulur.
// FAZ 11: yerel (logo filigranlı) görsel varsa ilk sıraya alınır.
//
// ÖNEMLİ: `product.images` ham Trendyol CDN URL'lerini içerir. Bu URL'ler
// JSON-LD'ye sızarsa hem marka bağımsızlığı iddiasıyla çelişir hem de Trendyol
// hotlink'i kestiğinde zengin sonuçlardaki görseller kırılır. Bu yüzden
// yapısal veride YALNIZCA yerelleştirilmiş (`/uploads/products/...`) görseller
// kullanılır; hiç yerel görsel yoksa CDN'e güvenli biçimde düşülür.
const localImages = galleryImages.filter(
  (url) => typeof url === 'string' && url.startsWith('/uploads/')
)
const productImages = Array.isArray(product.images) ? product.images : []
const orderedImages =
  localImages.length > 0
    ? localImages
    : primaryImage && !productImages.includes(primaryImage)
      ? [primaryImage, ...productImages]
      : productImages

/**
 * Structured data (`Product.image`) için görsel URL'ini mutlak hale getirir.
 * Google, JSON-LD içinde göreli (`/uploads/...`) URL kabul etmez; bu yüzden
 * site alan adıyla birleştirilir. Zaten mutlak olan URL'ler korunur.
 * @param {string} url
 * @returns {string}
 */
function toAbsoluteImageUrl(url) {
  const value = String(url || '').trim()
  if (value === '') {
    return value
  }
  if (/^https?:\/\//i.test(value)) {
    return value
  }
  return `${siteConfig.domain}${value.startsWith('/') ? '' : '/'}${value}`
}

const imageObjects = orderedImages.map((url) => ({
  '@type': 'ImageObject',
  url: toAbsoluteImageUrl(url),
  caption: `${displayTitle} - Motosiklet Reflektif Sticker SA Printpro`,
}))

// Google Merchant Center, `offers.price`/`lowPrice` alanı 0 olan ürünleri
// "geçersiz fiyat" olarak işaretler. Fiyatı olmayan ürünlerde `offers` bloğu
// tamamen atlanır; böylece zengin sonuçlarda hatalı "0 TL" gösterilmez.
const hasValidPrice = Number.isFinite(lowestPrice) && Number(lowestPrice) > 0

// Google Merchant Center / zengin sonuçlar için ürün kimlik alanları.
// `sku` varyant SKU'suna, `mpn` ise varyant barkoduna (varsa) dayanır.
const primaryVariant = variants[0] || {}
const productSku = primaryVariant.sku || product.id
const productMpn = primaryVariant.barcode || undefined

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: displayTitle,
  description: aiHook || plainDescription,
  image: imageObjects,
  sku: productSku,
  ...(productMpn ? { mpn: productMpn } : {}),
  brand: {
    '@type': 'Brand',
    name: brandInfo.name,
  },
  ...(hasValidPrice
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'TRY',
          lowPrice: lowestPrice,
          highPrice: highestPrice ?? lowestPrice,
          offerCount: pricedVariants.length,
          availability: inStock
            ? 'https://schema.org/InStock'
            : 'https://schema.org/OutOfStock',
          url: canonicalUrl,
          hasMerchantReturnPolicy: merchantReturnPolicy,
          shippingDetails,
        },
      }
    : {}),
}

// AIO & SearchGPT uyumlu semantik teknik özellik satırları.
// Sabit üretim gerçekleri, API'den gelen dinamik `attributes` ile birleştirilir.
// FAZ 11: AI detaylı özellikleri varsa sabit değerlerin yerine geçer.
// NOT: `attributeRows` artık burada TEKRAR edilmez; tekilleştirme için
// aşağıdaki `mergedSpecRows` birleşimine bakın.
const aioRows = [
  {
    key: 'Malzeme',
    value: detailedSpecs.material || '1. Kalite Döküm Reflektif Folyo',
  },
  {
    key: 'Gece Görünürlüğü',
    value: detailedSpecs.nightVisibility || 'Yüksek Yansıma (Petek Doku)',
  },
  {
    key: 'Dayanıklılık',
    value:
      detailedSpecs.durability ||
      'Su, Basınçlı Yıkama ve UV Işınlarına Dayanıklı (Solmaz)',
  },
  ...(detailedSpecs.removal
    ? [{ key: 'Sökülebilirlik', value: detailedSpecs.removal }]
    : []),
  { key: 'Menşei', value: 'Türkiye (SA Printpro Üretimi)' },
]

// Tek tablo: temel kimlik satırları + AI teknik satırları + API attribute'ları.
// Aynı `key` (büyük/küçük harf duyarsız) yalnızca ilk görüldüğü yerde tutulur;
// böylece sayfada tekrarlı satır kalmaz.
const mergedSpecRows = (() => {
  const seen = new Set()
  const rows = []
  for (const row of [...specRows, ...aioRows, ...attributeRows]) {
    const normalized = String(row.key).trim().toLocaleLowerCase('tr-TR')
    if (seen.has(normalized)) {
      continue
    }
    seen.add(normalized)
    rows.push(row)
  }
  return rows
})()

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: `${siteConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.name,
      item: categoryUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: product.name,
      item: canonicalUrl,
    },
  ],
}

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  image={primaryImage || (Array.isArray(product.images) ? product.images[0] : undefined)}
  canonicalUrl={canonicalUrl}
  type="product"
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <article class="mx-auto max-w-6xl px-4 pb-12">
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div>
        <Gallery client:visible images={galleryImages} title={displayTitle} />
      </div>

      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={`/kategori/${category.slug}/`}
              class="inline-flex w-fit items-center rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-600"
            >
              {category.name}
            </a>
            <span class="text-xs text-zinc-500 dark:text-zinc-400">
              {firstVariant.barcode || firstVariant.sku || product.id}
            </span>
          </div>
          <h1
            class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50"
          >
            {displayTitle}
          </h1>

          <!-- FAZ 11: AI hook — açıklama üstünde dikkat çekici giriş. -->
          {
            aiHook && (
              <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                {aiHook}
              </p>
            )
          }

          <!-- Programatik SEO: uyumlu motosiklet modeli rozetleri. -->
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">
              Uyumlu Motosiklet Modelleri
            </span>
            <div class="flex flex-wrap gap-1.5">
              {
                aiCompatibleModels.length > 0 ? (
                  aiCompatibleModels.map((model) => (
                    <span class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-2xs font-medium text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200">
                      {model}
                    </span>
                  ))
                ) : isUniversal ? (
                  <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-2xs font-medium text-emerald-700 dark:border-emerald-900/50 dark:bg-emerald-950/40 dark:text-emerald-300">
                    ✓ Üniversal - Tüm Motosiklet ve Araçlara Uyumlu
                  </span>
                ) : (
                  compatibleModels.map((entry) => (
                    <span class="inline-flex items-center rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-2xs font-medium text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200">
                      {entry.brand} {entry.model}
                    </span>
                  ))
                )
              }
            </div>
          </div>
        </div>

        <VariantSelector client:visible product={islandProduct} />

        <ProductShare client:idle slug={product.slug} title={displayTitle} />

        <ProductTrustBadges />
      </div>
    </div>

    <!-- Tekilleştirilmiş özellik tablosu (Ürün + Teknik + API attribute'ları). -->
    <section class="mt-12" aria-labelledby="product-spec-title">
      <div class="flex items-center gap-3">
        <h2
          id="product-spec-title"
          class="text-xl font-semibold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-50"
        >
          Ürün Özellikleri
        </h2>
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></span>
      </div>

      <dl
        class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-zinc-200 bg-zinc-200 sm:grid-cols-2 dark:border-zinc-800 dark:bg-zinc-800"
      >
        {
          mergedSpecRows.map((row) => (
            <div class="flex items-center justify-between gap-4 bg-white px-4 py-3 dark:bg-zinc-900">
              <dt class="text-xs text-zinc-500 dark:text-zinc-400">
                {row.key}
              </dt>
              <dd class="text-right text-sm font-medium text-zinc-900 dark:text-zinc-100">
                {row.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Product description. -->
    <section class="mt-12" aria-labelledby="product-description-title">
      <div class="flex items-center gap-3">
        <h2
          id="product-description-title"
          class="text-xl font-semibold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-50"
        >
          Ürün Açıklaması
        </h2>
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></span>
      </div>
      <div
        class="prose prose-sm mt-4 max-w-none whitespace-pre-line text-zinc-600 prose-headings:text-zinc-900 prose-a:text-zinc-900 prose-strong:text-zinc-900 dark:text-zinc-300 dark:prose-headings:text-zinc-100 dark:prose-a:text-zinc-100 dark:prose-strong:text-zinc-100"
      >
        {plainDescription || 'Bu ürün için açıklama bulunmuyor.'}
      </div>
    </section>

    <!-- FAQ. -->
    <section class="mt-12" aria-labelledby="product-faq-title">
      <div class="flex items-center gap-3">
        <h2
          id="product-faq-title"
          class="text-xl font-semibold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-50"
        >
          Sıkça Sorulan Sorular
        </h2>
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></span>
      </div>

      <div class="mt-4 flex flex-col gap-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-lg border border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900">
              <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-zinc-900 marker:content-none dark:text-zinc-100">
                <span>{faq.question}</span>
                <span
                  class="text-xs text-zinc-500 transition-transform group-open:rotate-45 dark:text-zinc-400"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- FAZ 11: AI uygulama rehberi (ürüne özel, varsa). -->
    {
      aiApplicationGuide && (
        <section class="mt-12" aria-labelledby="product-application-title">
          <div class="flex items-center gap-3">
            <h2
              id="product-application-title"
              class="text-xl font-semibold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-50"
            >
              Uygulama Rehberi
            </h2>
            <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800" />
          </div>
          <div class="prose prose-sm mt-4 max-w-none whitespace-pre-line text-zinc-600 prose-strong:text-zinc-900 dark:text-zinc-300 dark:prose-strong:text-zinc-100">
            {aiApplicationGuide}
          </div>
        </section>
      )
    }

    <!-- Application guide (static value layer for SEO). -->
    <HowToApply />

    {
      relatedProducts.length > 0 && (
        <section class="mt-12" aria-labelledby="related-products-title">
          <div class="flex items-center gap-3">
            <h2
              id="related-products-title"
              class="text-xl font-semibold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-50"
            >
              Benzer Ürünler
            </h2>
            <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800" />
          </div>
          <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {relatedProducts.map((related) => (
              <li>
                <ProductCard product={related} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(productJsonLd)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
