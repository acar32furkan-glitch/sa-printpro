---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { siteConfig } from '../config/site.js'

const canonicalUrl = `${siteConfig.domain}/mesafeli-satis-ve-iade`

const breadcrumbItems = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Mesafeli Satış ve İade' },
]

const sections = [
  {
    title: '1. Taraflar ve Konu',
    body: `İşbu metin, ${siteConfig.name} ile alıcı arasında 6502 sayılı Tüketicinin Korunması Hakkında Kanun ve Mesafeli Sözleşmeler Yönetmeliği kapsamında akdedilen mesafeli satış sözleşmesinin şartlarını özetler. Sitemiz bir vitrin (showcase) platformudur; sipariş ve ödeme işlemleri yönlendirme yapılan aracı platformlar üzerinden tamamlanır.`,
  },
  {
    title: '2. Sipariş ve Ödeme',
    body: 'Sitemizde doğrudan ödeme alınmaz. "Satın Al" butonları sizi Trendyol veya Shopier gibi güvenli aracı platformlara yönlendirir. Sipariş, ödeme, fatura ve teslimat süreçleri ilgili platformun kendi mesafeli satış sözleşmesi ve politikalarına tabidir.',
  },
  {
    title: '3. Cayma Hakkı (15 Gün İade)',
    body: 'Tüketici, ürünü teslim aldığı tarihten itibaren 15 (on beş) gün içinde hiçbir gerekçe göstermeksizin cayma hakkını kullanabilir. Cayma hakkı, ürünün ambalajının açılmamış ve yeniden satılabilir durumda olması kaydıyla geçerlidir. Kişiye özel üretilen (özel ölçü, özel tasarım) ürünlerde cayma hakkı, mevzuat gereği sınırlı olabilir.',
  },
  {
    title: '4. İade Süreci',
    body: 'Cayma hakkını kullanmak için siparişinizi verdiğiniz aracı platform üzerinden iade talebi oluşturmanız yeterlidir. İade talebi onaylandığında ürün, kargo firması aracılığıyla tarafımıza ulaştırılır. Ürünün tarafımıza ulaşmasını takiben en geç 14 gün içinde bedel iadesi, ödeme yaptığınız yönteme uygun şekilde gerçekleştirilir.',
  },
  {
    title: '5. Kargo ve Teslimat',
    body: `${siteConfig.badges.shipping}. ${siteConfig.badges.freeShipping} (${siteConfig.badges.freeShippingThreshold} TL ve üzeri siparişlerde). Kargo süresi, siparişin onaylanmasını takiben 1-3 iş günü transit süresini kapsar. Teslimat, aracı platformun anlaşmalı kargo firması aracılığıyla yapılır.`,
  },
  {
    title: '6. Ayıplı Ürün ve Garanti',
    body: 'Teslim edilen ürünün ayıplı (hasarlı, eksik veya tanımına uymayan) olması halinde, mevzuat kapsamındaki seçimlik haklarınız (onarım, değişim, bedel indirimi veya sözleşmeden dönme) saklıdır. Bu durumda ürünü teslim aldıktan sonra en kısa sürede bizimle iletişime geçmenizi rica ederiz.',
  },
  {
    title: '7. Uyuşmazlık Çözümü',
    body: 'İşbu sözleşmeden doğan uyuşmazlıklarda; Ticaret Bakanlığı tarafından ilan edilen parasal sınırlar dahilinde Tüketici Hakem Heyetleri, bu sınırların üzerindeki uyuşmazlıklarda ise Tüketici Mahkemeleri yetkilidir.',
  },
  {
    title: '8. İletişim',
    body: `Sorularınız için ${siteConfig.contact.email} adresinden veya WhatsApp üzerinden bize ulaşabilirsiniz.`,
  },
]
---

<Layout
  title="Mesafeli Satış ve İade Politikası"
  description={`${siteConfig.name} mesafeli satış sözleşmesi, 15 gün cayma hakkı, kargo ve iade süreci. 6502 sayılı kanuna uygun tüketici haklarınız.`}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-6xl px-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <article class="mx-auto max-w-3xl px-4 pb-16">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      Mesafeli Satış ve İade Politikası
    </h1>
    <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
      Son güncelleme: {new Date().getFullYear()}
    </p>

    <div class="mt-8 flex flex-col gap-8">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
              {section.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {section.body}
            </p>
          </section>
        ))
      }
    </div>
  </article>
</Layout>
